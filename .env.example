# BOSE shared environment baseline.
# Copy this file to .env at the repo root and inside each member service folder.
# All 5 Go services must share the SAME DB_URL and JWT_SECRET.

# PostgreSQL — Render-hosted DB (default).
# For local docker-compose Postgres set DB_URL=postgres://bose:bose@postgres:5432/bose?sslmode=disable
DB_URL=postgresql://bosedb_au8z_user:fyqLRsNhHP0OqkVyCavza8InkEzSV6xN@dpg-d870p8v7f7vs73f4o26g-a.frankfurt-postgres.render.com/bosedb_au8z?sslmode=require

# JWT signing key — IDENTICAL across every service so tokens issued by Furkan validate everywhere.
JWT_SECRET=bose_super_gizli_anahtar_2026

# Redis — single instance shared by all services (sessions, market prices, watchlists, alerts).
REDIS_URL=redis://localhost:6379

# RabbitMQ — single broker shared by all services.
# Exchange: bose.events (topic). Routing keys: order.filled, price.tick, user.registered.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Per-service ports (override only inside each service's own .env)
# Furkan :8080  Cem :8081  Salih :8082  Enes :8083  Efe :8084
PORT=8080
