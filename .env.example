# BOSE shared environment baseline.
# Copy this file to .env at each member service folder. NEVER commit the real .env.
# All 5 Go services must share the SAME DB_URL and JWT_SECRET.

# PostgreSQL DSN — Render-hosted in production. Always include ?sslmode=require for Render.
# For local docker-compose Postgres: postgres://bose:bose@postgres:5432/bose?sslmode=disable
DB_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

# JWT signing key — IDENTICAL across every service so tokens validate cross-service.
# Generate with: openssl rand -hex 32
JWT_SECRET=<replace-with-32-byte-hex-secret>

# Redis (shared session/cache layer)
REDIS_URL=redis://localhost:6379

# RabbitMQ (shared event broker)
# Exchange: bose.events (topic). Routing keys: order.filled, price.tick, user.registered.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Per-service ports (override in each service's own .env, never here)
# Suggested: Furkan :8080  Cem :8081  Salih :8082  Enes :8083  Efe :8084
PORT=8080
