# Environment — ignore ALL env files at any depth, but keep the *.example templates
*.env
.env
*.env.local
*.env.production
!*.env.example
!.env.example

# Secret-scrub working artifacts (never commit backups/mirrors of leaked history)
security/.scrub-work-*/
*-backup-*.git/

# Build artifacts
*/bin/
*/dist/
*/build/
*/node_modules/
*.log
*.test
*.out

# Final delivery artifacts (generated by build_all.sh / package_delivery.sh — never commit)
delivery/
BOSE_Final_Submission.zip
**/.vite/

# Go
*.exe
vendor/

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.idea/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/

# Editors
.idea/
.vscode/
*.swp
.DS_Store
