{
	"info": {
		"_postman_id": "enes-bose-collection",
		"name": "BOSE - Enes Çoban (AI Reports & Chat)",
		"description": "Enes Çoban'ın sorumlu olduğu 5 endpoint.\nAPI Base URL: https://bose-platform.onrender.com/api/v1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://bose-platform.onrender.com/api/v1"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "AI Reports",
			"item": [
				{
					"name": "1. POST /ai/advice - AI Yatırım Tavsiyesi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/ai/advice",
							"host": ["{{baseUrl}}"],
							"path": ["ai", "advice"]
						}
					}
				},
				{
					"name": "2. POST /ai/reports/portfolio - AI Portföy Analizi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/ai/reports/portfolio",
							"host": ["{{baseUrl}}"],
							"path": ["ai", "reports", "portfolio"]
						}
					}
				},
				{
					"name": "3. POST /ai/reports/watchlist - AI Watchlist Analizi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    {\"name\": \"BTC\", \"price\": 67000},\n    {\"name\": \"ETH\", \"price\": 3500}\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/reports/watchlist",
							"host": ["{{baseUrl}}"],
							"path": ["ai", "reports", "watchlist"]
						}
					}
				},
				{
					"name": "4. POST /ai/reports/transactions - AI İşlem Analizi",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/ai/reports/transactions",
							"host": ["{{baseUrl}}"],
							"path": ["ai", "reports", "transactions"]
						}
					}
				}
			]
		},
		{
			"name": "AI Chat",
			"item": [
				{
					"name": "5. POST /ai/chat - AI Chatbot",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message\": \"BTC hakkında ne düşünüyorsun?\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/ai/chat",
							"host": ["{{baseUrl}}"],
							"path": ["ai", "chat"]
						}
					}
				}
			]
		}
	]
}