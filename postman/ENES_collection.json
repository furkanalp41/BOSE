{
	"info": {
		"name": "BOSE - Enes",
		"description": "AI Reports & Chat endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "https://bose-platform.onrender.com/api/v1" },
		{ "key": "token", "value": "" }
	],
	"item": [
		{
			"name": "Login (token al)",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/auth/login",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\"email\":\"enes_test@bose.dev\",\"password\":\"Test1234!\"}" }
			},
			"event": [{
				"listen": "test",
				"script": { "exec": ["var json = pm.response.json(); pm.collectionVariables.set('token', json.token);"] }
			}]
		},
		{
			"name": "POST /ai/advice",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/ai/advice",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "POST /ai/chat",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/ai/chat",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{\"message\":\"BTC hakkinda ne dusunuyorsun?\"}" }
			}
		},
		{
			"name": "POST /ai/reports/portfolio",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/ai/reports/portfolio",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "POST /ai/reports/transactions",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/ai/reports/transactions",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "POST /ai/reports/watchlist",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/ai/reports/watchlist",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{\"items\":[{\"name\":\"BTC\",\"price\":67000},{\"name\":\"ETH\",\"price\":3500}]}" }
			}
		}
	]
}
