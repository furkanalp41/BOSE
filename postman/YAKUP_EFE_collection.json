{
	"info": {
		"_postman_id": "yakup-efe-bose-collection",
		"name": "BOSE - Yakup Efe Çelebi (Market, Leaderboard, Admin Assets)",
		"description": "Yakup Efe Çelebi'nin sorumlu olduğu 7 endpoint.\nAPI Base URL: https://bose-platform.onrender.com/api/v1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://bose-platform.onrender.com/api/v1"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Market",
			"item": [
				{
					"name": "1. GET /market/assets - Canlı Piyasa Verileri (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/market/assets",
							"host": ["{{baseUrl}}"],
							"path": ["market", "assets"]
						}
					}
				}
			]
		},
		{
			"name": "Leaderboard",
			"item": [
				{
					"name": "2. GET /leaderboard/rankings - Global Sıralama",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/leaderboard/rankings",
							"host": ["{{baseUrl}}"],
							"path": ["leaderboard", "rankings"]
						}
					}
				},
				{
					"name": "3. GET /leaderboard/user/:userId - Kullanıcı Sıralaması",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/leaderboard/user/1",
							"host": ["{{baseUrl}}"],
							"path": ["leaderboard", "user", "1"]
						}
					}
				},
				{
					"name": "4. GET /leaderboard/achievements - Başarımlar",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/leaderboard/achievements",
							"host": ["{{baseUrl}}"],
							"path": ["leaderboard", "achievements"]
						}
					}
				}
			]
		},
		{
			"name": "Admin Assets",
			"item": [
				{
					"name": "5. GET /admin/market/assets - Admin Asset Listesi",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/market/assets",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "market", "assets"]
						}
					}
				},
				{
					"name": "6. POST /admin/market/assets - Yeni Asset Ekle",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"TSLA\",\n  \"price\": 245.50,\n  \"drift\": 0.0001,\n  \"volatility\": 0.0015\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/admin/market/assets",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "market", "assets"]
						}
					}
				},
				{
					"name": "7. DELETE /admin/market/assets/:symbol - Asset Sil",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/admin/market/assets/TSLA",
							"host": ["{{baseUrl}}"],
							"path": ["admin", "market", "assets", "TSLA"]
						}
					}
				}
			]
		}
	]
}