{
	"info": {
		"name": "BOSE - Yakup Efe",
		"description": "Market, Leaderboard, Admin Asset endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "https://bose-platform.onrender.com/api/v1" },
		{ "key": "token", "value": "" }
	],
	"item": [
		{
			"name": "Login (token al)",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/auth/login",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": { "mode": "raw", "raw": "{\"email\":\"efe_test@bose.dev\",\"password\":\"Test1234!\"}" }
			},
			"event": [{
				"listen": "test",
				"script": { "exec": ["var json = pm.response.json(); pm.collectionVariables.set('token', json.token);"] }
			}]
		},
		{
			"name": "GET /market/assets (public)",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/market/assets"
			}
		},
		{
			"name": "GET /leaderboard/rankings",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/leaderboard/rankings",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "GET /leaderboard/user/:userId",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/leaderboard/user/1",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "GET /leaderboard/achievements",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/leaderboard/achievements",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "GET /admin/market/assets",
			"request": {
				"method": "GET",
				"url": "{{baseUrl}}/admin/market/assets",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		},
		{
			"name": "POST /admin/market/assets (yeni asset)",
			"request": {
				"method": "POST",
				"url": "{{baseUrl}}/admin/market/assets",
				"header": [
					{ "key": "Authorization", "value": "Bearer {{token}}" },
					{ "key": "Content-Type", "value": "application/json" }
				],
				"body": { "mode": "raw", "raw": "{\"symbol\":\"TSLA\",\"price\":245.50,\"drift\":0.0001,\"volatility\":0.0015}" }
			}
		},
		{
			"name": "DELETE /admin/market/assets/:symbol",
			"request": {
				"method": "DELETE",
				"url": "{{baseUrl}}/admin/market/assets/TSLA",
				"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
			}
		}
	]
}
